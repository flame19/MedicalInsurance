      "name": "01. Клієнти",
      "item": [
        {
          "name": "POST | Створити",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Олена Коваль\",\n  \"email\": \"demo@example.com\",\n  \"phone\": \"+380500000001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Created ID\", () => pm.expect(data.id).to.be.a(\"number\").and.greaterThan(0));",
                  "    pm.collectionVariables.set(\"clientId\", String(data.id));",
                  "    pm.test(\"Location points to created resource\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/\" + data.id));",
                  "    pm.test(\"Correct phone\", () => pm.expect(data.phone).to.equal(\"+380500000001\"));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
